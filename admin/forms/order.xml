<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="details">
        <field name="id" type="hidden" />
        <field name="status" type="list" label="JSTATUS" class="form-select">
            <option value="pending">COM_SANCTUARYSHOP_ORDER_STATUS_PENDING</option>
            <option value="processing">COM_SANCTUARYSHOP_ORDER_STATUS_PROCESSING</option>
            <option value="completed">COM_SANCTUARYSHOP_ORDER_STATUS_COMPLETED</option>
            <option value="cancelled">COM_SANCTUARYSHOP_ORDER_STATUS_CANCELLED</option>
            <option value="refunded">COM_SANCTUARYSHOP_ORDER_STATUS_REFUNDED</option>
        </field>
        <field name="notes" type="textarea" label="COM_SANCTUARYSHOP_FIELD_NOTES" rows="4" class="form-control" />
    </fieldset>
</form>
