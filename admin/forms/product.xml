<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="details">
        <field name="id" type="hidden" />
        <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" class="form-control" />
        <field name="product_type" type="list" label="COM_SANCTUARYSHOP_FIELD_PRODUCT_TYPE" default="physical" class="form-select">
            <option value="physical">COM_SANCTUARYSHOP_PRODUCT_TYPE_PHYSICAL</option>
            <option value="digital">COM_SANCTUARYSHOP_PRODUCT_TYPE_DIGITAL</option>
            <option value="subscription">COM_SANCTUARYSHOP_PRODUCT_TYPE_SUBSCRIPTION</option>
            <option value="service">COM_SANCTUARYSHOP_PRODUCT_TYPE_SERVICE</option>
        </field>
        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" hint="JFIELD_ALIAS_PLACEHOLDER" maxlength="400" class="form-control" />
        <field name="description" type="editor" label="JGLOBAL_DESCRIPTION" buttons="true" hide="readmore" filter="safehtml" />
        <field name="price" type="number" label="COM_SANCTUARYSHOP_FIELD_PRICE" required="true" min="0" step="0.01" class="form-control" />
        <field name="sale_price" type="number" label="COM_SANCTUARYSHOP_FIELD_SALE_PRICE" min="0" step="0.01" class="form-control" />
        <field name="sku" type="text" label="COM_SANCTUARYSHOP_FIELD_SKU" maxlength="100" class="form-control" />
        <field name="stock" type="number" label="COM_SANCTUARYSHOP_FIELD_STOCK" required="true" min="0" step="1" default="0" class="form-control" />
        <field name="state" type="list" label="JSTATUS" default="1" class="form-select">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
        <field name="category_id" type="category" label="JCATEGORY" extension="com_sanctuaryshop" class="form-select" />
        <field name="image" type="media" label="COM_SANCTUARYSHOP_FIELD_IMAGE" class="form-control" />
        <field name="ordering" type="ordering" label="JFIELD_ORDERING_LABEL" class="form-control" />
    </fieldset>
</form>
