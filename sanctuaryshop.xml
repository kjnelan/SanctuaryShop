<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
    <name>SanctuaryShop</name>
    <author>Kenneth J Nelan</author>
    <authorEmail>ken.nelan@sacwan.net</authorEmail>
    <authorUrl>https://sacwan.net</authorUrl>
    <creationDate>2026-06-09</creationDate>
    <copyright>Copyright (C) 2026 Sacred Wandering, Inc. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.2.0</version>
    <schemaversion>1.2.0</schemaversion>
    <scriptfile>script.php</scriptfile>
    <description>COM_SANCTUARYSHOP_DESCRIPTION</description>

    <namespace path="src">SanctuaryShop\Component\Sanctuaryshop</namespace>

    <install>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <files folder="site">
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages folder="site/language">
        <language tag="en-GB">en-GB/com_sanctuaryshop.ini</language>
    </languages>

    <media folder="media" destination="com_sanctuaryshop">
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
    </media>

    <administration>
        <menu link="option=com_sanctuaryshop">COM_SANCTUARYSHOP</menu>
        <submenu>
            <menu link="option=com_sanctuaryshop&amp;view=products">COM_SANCTUARYSHOP_PRODUCTS</menu>
            <menu link="option=com_categories&amp;extension=com_sanctuaryshop&amp;view=categories">COM_SANCTUARYSHOP_CATEGORIES</menu>
            <menu link="option=com_sanctuaryshop&amp;view=orders">COM_SANCTUARYSHOP_ORDERS</menu>
            <menu link="option=com_sanctuaryshop&amp;view=downloads">COM_SANCTUARYSHOP_DOWNLOADS</menu>
            <menu link="option=com_sanctuaryshop&amp;view=coupons">COM_SANCTUARYSHOP_COUPONS</menu>
        </submenu>
        <files folder="admin">
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>forms</folder>
            <folder>sql</folder>
            <folder>language</folder>
            <file>access.xml</file>
            <file>config.xml</file>
        </files>
        <languages folder="admin/language">
            <language tag="en-GB">en-GB/com_sanctuaryshop.ini</language>
            <language tag="en-GB">en-GB/com_sanctuaryshop.sys.ini</language>
        </languages>
    </administration>

    <changelogurl>https://example.com/changelog.xml</changelogurl>
    <updateservers>
        <server type="extension" name="SanctuaryShop Updates">https://example.com/updates.xml</server>
    </updateservers>
</extension>
